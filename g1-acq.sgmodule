#!name=G1 ACQ
#!desc=Google One /ai The product ID of the subscription page is mapped to the real discount file (20TB/30TB AI Ultra), 不含诊断与上报
#!system=ios

[Rule]
# Google App 走 HTTP/3 The response cannot be decrypted and needs to be blocked. QUIC
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/ai\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/shenglong209/g1-acq/refs/heads/main/g1-acq.js

[MITM]
hostname = %APPEND% one.google.com
